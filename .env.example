# ===== BINANCE API (USDT-M Futures) =====
# Получить: https://www.binance.com/en/my/settings/api-management
# Нужны права: "Futures Trading" (Read + Enabled)
# Оставь пустыми для DEMO режима (mock данные)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Использовать testnet? (https://testnet.binancefuture.com)
# true = testnet, false = mainnet (по умолчанию)
BINANCE_TESTNET=false

# ===== TELEGRAM =====
# Канал для мониторинга (публичный username без @)
TELEGRAM_CHANNEL=cryptoalr

# ===== TELEGRAM USER API (MTProto) =====
# Получить: https://my.telegram.org → API development tools
# Без этих данных парсинг t.me/s/ может не работать
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session string — генерируется один раз после авторизации
# Запусти: bun run scripts/telegram-login.ts
TELEGRAM_SESSION=

# Способ мониторинга:
#   "mtproto" — через User API (нужно TELEGRAM_API_ID + API_HASH + SESSION)
#   "scrape"  — через t.me/s/<channel> (без авторизации, не для всех каналов)
TELEGRAM_METHOD=mtproto

# ===== WORKER =====
# Интервал парсинга Telegram (в секундах)
WORKER_POLL_INTERVAL_SEC=20

# Интервал проверки позиций (в секундах)
WORKER_CHECK_INTERVAL_SEC=5

# ===== TRADING SETTINGS (можно изменить через UI) =====
# Кредитное плечо (1-125 для USDT-M)
DEFAULT_LEVERAGE=75

# Размер позиции в % от доступного USDT баланса (1-100)
DEFAULT_POSITION_SIZE_PCT=5

# Take profit % (по умолчанию 10% от цены входа)
DEFAULT_TAKE_PROFIT_PCT=10

# Stop loss % (по умолчанию -5% от цены входа, положительное число!)
DEFAULT_STOP_LOSS_PCT=5

# Включить торговлю? (false = только мониторинг сигналов)
TRADING_ENABLED=false

# ===== DATABASE (Prisma) =====
DATABASE_URL=file:./db/custom.db
